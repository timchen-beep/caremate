# 作用：树莓派 systemd 单元：跑 MQTT 桥（outbox → broker）
[Unit]
Description=CareMate MQTT bridge (outbox -> mosquitto)
After=network-online.target caremate-server.service mosquitto.service
Wants=caremate-server.service

[Service]
Type=simple
User=caremate
WorkingDirectory=/opt/caremate
Environment=CAREMATE_API=http://127.0.0.1:8000
ExecStart=/usr/bin/python3 /opt/caremate/bridge.py --host 127.0.0.1 --api http://127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

