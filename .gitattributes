# 作用：行尾规则：仓库存 LF、bat 用 CRLF、二进制文件不做转换
# 统一行尾：仓库里存 LF，避免 Windows 上反复出现"只有行尾变了"的假改动
* text=auto eol=lf

# 脚本：sh 必须 LF，bat 必须 CRLF
*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制，不要做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.jar  binary
*.apk  binary
*.aab  binary
*.db   binary
*.7z   binary
*.zip  binary

# 文档与源码保持 LF
*.md   text eol=lf
*.py   text eol=lf
*.dart text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.ino  text eol=lf
*.prop text eol=lf

