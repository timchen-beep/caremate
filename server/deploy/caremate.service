# 作用：systemd 单元：以单进程跑后端（多进程会有两个调度循环）
[Unit]
Description=CareMate cloud service (single process, built-in scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caremate
Group=caremate
WorkingDirectory=/opt/caremate
# 单进程：调度器在进程内，多 worker 会重复触发升级
ExecStart=/opt/caremate/.venv/bin/python /opt/caremate/server.py --host 127.0.0.1 --port 8000
# 令牌/配对码放在 .env（由 deploy/setup.sh 或 tools/rotate_tokens.py 生成）
EnvironmentFile=-/opt/caremate/.env
Environment=CAREMATE_MODE=cloud
Environment=CAREMATE_TZ=Asia/Shanghai
Environment=CAREMATE_DB=/opt/caremate/caremate.db
Environment=CAREMATE_SCHEDULER=1
# 生产环境把下面两行换成真实值（JWT 密钥、MQTT/Webhook 出口）
# Environment=CAREMATE_JWT_SECRET=change-me
# Environment=CAREMATE_MQTT_URL=mqtt://127.0.0.1:1883
Restart=always
RestartSec=2
# 只允许写自己的工作目录
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/caremate
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

