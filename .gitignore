# 作用：忽略规则：数据库、令牌文件、签名私钥、构建产物、APK、CI 临时文件

# 数据与运行时
*.db
*.db-wal
*.db-shm
server.pid
backups/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Flutter / Android
app/build/
app/.dart_tool/
app/.idea/
app/.gradle/
app/.kotlin/
app/android/.gradle/
app/android/app/build/
app/*.iml
app/android/*.iml
.packages
.pub-cache/
.pub/

# 签名私钥（绝不入库）
*.jks
*.keystore
app/android/key.properties

# 构建产物
*.apk
*.aab
*.so

# 编辑器
.vscode/
.DS_Store
Thumbs.db

# Qt 构建产物
qt/build/
*.o
*.obj
moc_*
CMakeCache.txt
CMakeFiles/
*.user

# 本机私密配置（令牌/配对码，绝不入库）
server/.env
server/.env.*
!server/.env.example
.env
.env.*

# 运行时日志（自启脚本写的）
server/server.log

# CI 与本地验收产生的临时文件
ci_test.db*
acceptance*.json
acceptance.json
