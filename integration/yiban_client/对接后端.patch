diff --git a/src/comm/sync_engine.cpp b/src/comm/sync_engine.cpp
new file mode 100644
index 0000000..2e8546c
--- /dev/null
+++ b/src/comm/sync_engine.cpp
@@ -0,0 +1,271 @@
+#include "sync_engine.h"
+
+#include "http_client.h"
+#include "vm/app_core.h"
+
+#include <QDateTime>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QSettings>
+#include <QUuid>
+#include <QVariantList>
+#include <QVariantMap>
+
+namespace {
+// 服务端动作名 ← 端上动作名（端上用 confirm/snooze/miss/escalate/undo）
+QString clientAction(const QString &name)
+{
+    if (name == QLatin1String("confirmed"))
+        return QStringLiteral("confirm");
+    if (name == QLatin1String("snoozed"))
+        return QStringLiteral("snooze");
+    if (name == QLatin1String("missed"))
+        return QStringLiteral("miss");
+    if (name == QLatin1String("escalated"))
+        return QStringLiteral("escalate");
+    if (name == QLatin1String("reopen"))
+        return QStringLiteral("undo");
+    return name;
+}
+} // namespace
+
+SyncEngine::SyncEngine(HttpClient *http, QObject *parent)
+    : QObject(parent)
+    , m_http(http)
+{
+    QSettings settings;
+    m_deviceId = settings.value(QStringLiteral("device/id")).toString();
+    if (m_deviceId.isEmpty()) {
+        m_deviceId = QStringLiteral("android-") + QUuid::createUuid().toString(QUuid::WithoutBraces).left(13);
+        settings.setValue(QStringLiteral("device/id"), m_deviceId);
+    }
+    AppCore::instance()->setDeviceId(m_deviceId);
+
+    connect(m_http, &HttpClient::reply, this, &SyncEngine::onReply);
+    connect(m_http, &HttpClient::failed, this, &SyncEngine::onFailed);
+
+    // 端上有新事件（用户点了确认/推迟…）→ 尽快上传
+    connect(AppCore::instance(), &AppCore::occurrencesChanged, this, [this] {
+        if (!m_busy && pendingCount() > 0)
+            pushPending();
+    });
+
+    connect(AppCore::instance(), &AppCore::pairRequested, this, &SyncEngine::pair);
+
+    m_timerFast.setInterval(15000);
+    connect(&m_timerFast, &QTimer::timeout, this, &SyncEngine::tick);
+    m_timerSlow.setInterval(60000);
+    connect(&m_timerSlow, &QTimer::timeout, this, [this] { pullPlans(); });
+    m_retryTimer.setSingleShot(true);
+    connect(&m_retryTimer, &QTimer::timeout, this, [this] {
+        if (!m_busy)
+            m_cursor == 0 ? pullPlans() : pullState();
+    });
+}
+
+void SyncEngine::start()
+{
+    m_timerFast.start();
+    m_timerSlow.start();
+    pullPlans();       // 先计划：没有计划就没有 occurrence
+}
+
+int SyncEngine::pendingCount() const
+{
+    return AppCore::instance()->pendingEvents().size();
+}
+
+void SyncEngine::setState(const QString &state)
+{
+    if (m_state == state)
+        return;
+    m_state = state;
+    emit stateChanged();
+}
+
+void SyncEngine::pullPlans()
+{
+    if (m_busy)
+        return;   // 一次只跑一个请求：回执按 m_pendingOp 分派，不能并行
+    m_pendingOp = Op::Plans;
+    m_busy = true;
+    setState(QStringLiteral("syncing"));
+    QUrlQuery query;
+    query.addQueryItem(QStringLiteral("since"), QString::number(0)); // 计划量小，直接全量
+    m_http->getJson(QStringLiteral("/v1/plans"), query);
+}
+
+void SyncEngine::pullState()
+{
+    if (m_busy)
+        return;
+    m_pendingOp = Op::State;
+    m_busy = true;
+    setState(QStringLiteral("syncing"));
+    QUrlQuery query;
+    query.addQueryItem(QStringLiteral("since"), QString::number(m_cursor));
+    m_http->getJson(QStringLiteral("/v1/state"), query);
+}
+
+void SyncEngine::pushPending()
+{
+    if (m_busy)
+        return;
+    const QVariantList events = AppCore::instance()->pendingEvents();
+    if (events.isEmpty()) {
+        setState(QStringLiteral("idle"));
+        return;
+    }
+    QJsonArray array;
+    for (const QVariant &entry : events) {
+        const QVariantMap event = entry.toMap();
+        QJsonObject item;
+        item[QStringLiteral("event_id")] = event.value(QStringLiteral("eventId")).toString();
+        item[QStringLiteral("occurrence_id")] = event.value(QStringLiteral("occurrenceId")).toLongLong();
+        item[QStringLiteral("action")] = clientAction(event.value(QStringLiteral("action")).toString());
+        item[QStringLiteral("ts")] = event.value(QStringLiteral("ts")).toLongLong();
+        item[QStringLiteral("device_id")] = m_deviceId;
+        item[QStringLiteral("reason")] = event.value(QStringLiteral("reason")).toString();
+        array.append(item);
+    }
+    QJsonObject body;
+    body[QStringLiteral("events")] = array;
+
+    m_pendingOp = Op::Events;
+    m_busy = true;
+    setState(QStringLiteral("syncing"));
+    m_http->postJson(QStringLiteral("/v1/events"), body);
+}
+
+void SyncEngine::retry()
+{
+    m_retryTimer.stop();
+    m_retryDelayMs = 1000;
+    if (m_cursor == 0)
+        pullPlans();
+    else
+        pullState();
+}
+
+void SyncEngine::pair(const QString &code)
+{
+    if (m_busy)
+        return;
+    QJsonObject body;
+    body[QStringLiteral("pair_code")] = code.trimmed();
+    body[QStringLiteral("device_id")] = m_deviceId;
+    body[QStringLiteral("role")] = QStringLiteral("elder");
+    m_pendingOp = Op::Pair;
+    m_busy = true;
+    setState(QStringLiteral("syncing"));
+    m_http->postJson(QStringLiteral("/v1/pair"), body);
+}
+
+void SyncEngine::tick()
+{
+    m_slowTicks++;
+    if (m_busy)
+        return;
+    if (pendingCount() > 0) {
+        pushPending();
+        return;
+    }
+    pullState();
+}
+
+void SyncEngine::scheduleRetry()
+{
+    setState(QStringLiteral("offline"));
+    m_retryTimer.start(m_retryDelayMs);
+    m_retryDelayMs = qMin(m_retryDelayMs * 2, 5 * 60 * 1000);
+}
+
+void SyncEngine::onFailed(quint64 requestId, const QString &code)
+{
+    Q_UNUSED(requestId)
+    Q_UNUSED(code)
+    m_busy = false;
+    scheduleRetry();
+}
+
+void SyncEngine::onReply(quint64 requestId, int status, const QJsonObject &body)
+{
+    Q_UNUSED(requestId)
+    m_busy = false;
+    m_retryDelayMs = 1000;
+
+    if (status == 401 || status == 403) {
+        setState(QStringLiteral("error"));
+        emit commandRejected(QStringLiteral("auth"), QStringLiteral("令牌失效，请重新配对"));
+        return;
+    }
+    if (status >= 400) {
+        setState(QStringLiteral("error"));
+        return;
+    }
+
+    switch (m_pendingOp) {
+    case Op::Plans: {
+        const QJsonArray plans = body.value(QStringLiteral("plans")).toArray();
+        QVariantList list;
+        for (const QJsonValue &value : plans)
+            list.append(value.toObject().toVariantMap());
+        AppCore::instance()->applyRemotePlans(list);
+        pullState();
+        break;
+    }
+    case Op::State: {
+        const QJsonArray occurrences = body.value(QStringLiteral("occurrences")).toArray();
+        QVariantList list;
+        for (const QJsonValue &value : occurrences)
+            list.append(value.toObject().toVariantMap());
+        AppCore::instance()->applyRemoteOccurrences(list);
+        const qint64 nextSeq = static_cast<qint64>(body.value(QStringLiteral("next_seq")).toDouble());
+        if (nextSeq > m_cursor)
+            m_cursor = nextSeq;
+        m_lastSyncTs = QDateTime::currentMSecsSinceEpoch();
+        setState(QStringLiteral("idle"));
+        if (pendingCount() > 0)
+            pushPending();
+        break;
+    }
+    case Op::Events: {
+        const QJsonArray accepted = body.value(QStringLiteral("accepted")).toArray();
+        QVariantList applied;
+        for (const QJsonValue &value : accepted) {
+            const QJsonObject item = value.toObject();
+            if (item.value(QStringLiteral("applied")).toBool(false)) {
+                QVariantMap entry;
+                entry[QStringLiteral("eventId")] = item.value(QStringLiteral("event_id")).toString();
+                entry[QStringLiteral("serverSeq")] =
+                    static_cast<qint64>(item.value(QStringLiteral("server_seq")).toDouble());
+                applied.append(entry);
+            }
+        }
+        if (!applied.isEmpty())
+            AppCore::instance()->markEventsUploaded(applied);
+        m_lastSyncTs = QDateTime::currentMSecsSinceEpoch();
+        setState(QStringLiteral("idle"));
+        break;
+    }
+    case Op::Pair: {
+        const QString token = body.value(QStringLiteral("token")).toString();
+        if (auto *real = qobject_cast<QNetworkHttpClient *>(m_http)) {
+            if (!token.isEmpty())
+                real->setToken(token);
+        }
+        if (!token.isEmpty()) {
+            emit toast(QStringLiteral("已和后端配对"));
+            pullPlans();
+        } else {
+            setState(QStringLiteral("error"));
+        }
+        break;
+    }
+    case Op::Alarm:
+        setState(QStringLiteral("idle"));
+        break;
+    }
+    m_retryTimer.stop();
+}
diff --git a/src/comm/sync_engine.h b/src/comm/sync_engine.h
new file mode 100644
index 0000000..28426d8
--- /dev/null
+++ b/src/comm/sync_engine.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <QHash>
+#include <QJsonObject>
+#include <QObject>
+#include <QTimer>
+#include <QUrlQuery>
+
+class HttpClient;
+
+// 同步引擎（B2）：把端上队列与 CareMate 后端的 /v1/* 接起来。
+//
+// 职责边界：
+//   * 只做"拉下来 → 交给 AppCore 应用"和"端上队列 → 发上去"；
+//   * 不碰状态机（状态迁移仍由 AppCore / 后端 transition() 决定）；
+//   * 不碰 QML。
+//
+// 拉取节奏：启动拉一次；之后每 15 秒拉状态、每 60 秒拉计划；
+// 上传：有待传事件就发，失败指数退避（1s/2s/4s…上限 5 分钟）。
+class SyncEngine : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit SyncEngine(HttpClient *http, QObject *parent = nullptr);
+
+    void start();
+
+    // offline / idle / syncing / error —— 与 SyncVM.syncState 同一套词
+    QString state() const { return m_state; }
+    qint64 lastSyncTs() const { return m_lastSyncTs; }
+    int pendingCount() const;
+
+    // 立即重试一次（SyncVM.retrySync 调到）
+    void retry();
+
+    // 6 位配对码 → 后端换令牌；成功后写入 QSettings 并立即全量同步
+    void pair(const QString &code);
+
+signals:
+    void stateChanged();
+    void toast(const QString &text);
+    void commandRejected(const QString &code, const QString &message);
+
+private slots:
+    void onReply(quint64 requestId, int status, const QJsonObject &body);
+    void onFailed(quint64 requestId, const QString &code);
+    void tick();
+
+private:
+    enum class Op { Plans, State, Events, Alarm, Pair };
+
+    void setState(const QString &state);
+    void pullPlans();
+    void pullState();
+    void pushPending();
+    void scheduleRetry();
+
+    HttpClient *m_http = nullptr;
+    Op m_pendingOp = Op::State;      // 同时只跑一个请求，够用且不会打乱顺序
+    bool m_busy = false;
+    qint64 m_cursor = 0;             // server_seq：已应用到的位置
+    qint64 m_lastSyncTs = 0;
+    QString m_state = QStringLiteral("offline");
+    int m_retryDelayMs = 1000;
+
+    QTimer m_timerFast;              // 15s：拉状态 / 推队列
+    QTimer m_timerSlow;              // 60s：拉计划
+    QTimer m_retryTimer;
+    int m_slowTicks = 0;
+
+    QString m_deviceId;
+};
