+QNetworkHttpClient::QNetworkHttpClient(QObject *parent)
+    : HttpClient(parent)
+    , m_nam(new QNetworkAccessManager(this))
+{
+    QSettings settings;
+    m_baseUrl = qEnvironmentVariable("YIBAN_API");
+    if (m_baseUrl.isEmpty())
+        m_baseUrl = settings.value(QStringLiteral("api/baseUrl")).toString();
+    if (m_baseUrl.isEmpty())
+        m_baseUrl = QStringLiteral("http://10.0.2.2:8400");
+    while (m_baseUrl.endsWith(QLatin1Char('/')))
+        m_baseUrl.chop(1);
+
+    m_token = qEnvironmentVariable("YIBAN_TOKEN");
+    if (m_token.isEmpty())
+        m_token = settings.value(QStringLiteral("api/token")).toString();
+    if (m_token.isEmpty())
+        m_token = QStringLiteral("app-elder-001"); // 演示令牌（后端 init_db 写入）
+}
+
+void QNetworkHttpClient::setBaseUrl(const QString &url)
+{
+    m_baseUrl = url;
+    while (m_baseUrl.endsWith(QLatin1Char('/')))
+        m_baseUrl.chop(1);
+    QSettings settings;
+    settings.setValue(QStringLiteral("api/baseUrl"), m_baseUrl);
+}
+
+void QNetworkHttpClient::setToken(const QString &token)
+{
+    m_token = token;
+    QSettings settings;
+    settings.setValue(QStringLiteral("api/token"), m_token);
+}
+
+QUrl QNetworkHttpClient::urlFor(const QString &path) const
+{
+    return QUrl(m_baseUrl + path);
+}
+
+void QNetworkHttpClient::track(quint64 id, QNetworkReply *reply)
+{
+    connect(reply, &QNetworkReply::finished, this, [this, id, reply] {
+        reply->deleteLater();
+        const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        const QByteArray payload = reply->readAll();
+
+        if (reply->error() != QNetworkReply::NoError && status == 0) {
+            // 连不上服务器：保持 offline，让 SyncEngine 走退避重试
+            m_online = false;
+            emit failed(id, reply->errorString());
+            return;
+        }
+        QJsonObject body;
+        if (!payload.isEmpty()) {
+            const QJsonDocument doc = QJsonDocument::fromJson(payload);
+            if (doc.isObject())
+                body = doc.object();
+            else if (doc.isArray())
+                body = QJsonObject{{QStringLiteral("items"), doc.array()}};
+        }
+        // 401/403 说明令牌失效，上层会提示重新配对；其余都算"网络通"
+        m_online = true;
+        emit reply(id, status, body);
+    });
+}
+
+quint64 QNetworkHttpClient::postJson(const QString &path, const QJsonObject &body)
+{
+    const quint64 id = m_nextId++;
+    QNetworkRequest request(urlFor(path));
+    request.setHeader(QNetworkRequest::ContentTypeHeader, QStringLiteral("application/json"));
+    request.setRawHeader("Accept", "application/json");
+    if (!m_token.isEmpty())
+        request.setRawHeader("X-Token", m_token.toUtf8());
+    QNetworkReply *reply = m_nam->post(request, QJsonDocument(body).toJson(QJsonDocument::Compact));
+    track(id, reply);
+    return id;
+}
+
+quint64 QNetworkHttpClient::getJson(const QString &path, const QUrlQuery &query)
+{
+    const quint64 id = m_nextId++;
+    QUrl url = urlFor(path);
+    if (!query.isEmpty())
+        url.setQuery(query);
+    QNetworkRequest request(url);
+    request.setRawHeader("Accept", "application/json");
+    if (!m_token.isEmpty())
+        request.setRawHeader("X-Token", m_token.toUtf8());
+    QNetworkReply *reply = m_nam->get(request);
+    track(id, reply);
+    return id;
+}
