@@ -1023,3 +1024,123 @@ void AppCore::resetDemo()
     seedDemo();
     emit toast(QStringLiteral("演示数据已恢复"));
 }
+
+// ---------------------------------------------------------------- 远端同步（B2 SyncEngine 用）
+// 函数 applyRemotePlans：把 /v1/plans 的 snake_case 计划合并进内存计划表
+void AppCore::applyRemotePlans(const QVariantList &remote)
+{
+    if (remote.isEmpty())
+        return;
+    for (const QVariant &entry : remote) {
+        const QVariantMap src = entry.toMap();
+        const qint64 planId = static_cast<qint64>(src.value(QStringLiteral("plan_id")).toDouble());
+        if (planId <= 0)
+            continue;
+
+        QVariantMap stored;
+        stored[QStringLiteral("planId")] = planId;
+        stored[QStringLiteral("title")] = src.value(QStringLiteral("title"));
+        stored[QStringLiteral("dose")] = src.value(QStringLiteral("dose"));
+        stored[QStringLiteral("note")] = src.value(QStringLiteral("note"));
+        stored[QStringLiteral("rule")] = src.value(QStringLiteral("rule")).toMap();
+        stored[QStringLiteral("windowMin")] =
+            src.value(QStringLiteral("window_min")).toInt();
+        stored[QStringLiteral("escalateAfterMin")] =
+            src.value(QStringLiteral("escalate_after_min")).toInt();
+        stored[QStringLiteral("version")] = src.value(QStringLiteral("version")).toInt();
+        stored[QStringLiteral("deleted")] = src.value(QStringLiteral("deleted")).toBool();
+
+        const int index = indexOfPlan(planId);
+        if (index >= 0)
+            m_plans[index] = stored;      // 服务端是权威：同 id 直接覆盖
+        else
+            m_plans.append(stored);
+        m_nextPlanId = qMax(m_nextPlanId, planId + 1);
+    }
+    emit plansChanged();
+    rebuildToday();
+}
+
+// 函数 applyRemoteOccurrences：把 /v1/state 的实例合并进今天清单（替换同 id，追加新 id）
+void AppCore::applyRemoteOccurrences(const QVariantList &remote)
+{
+    if (remote.isEmpty())
+        return;
+    QHash<qint64, QVariantMap> incoming;
+    for (const QVariant &entry : remote) {
+        const QVariantMap src = entry.toMap();
+        const qint64 occurrenceId =
+            static_cast<qint64>(src.value(QStringLiteral("occurrence_id")).toDouble());
+        if (occurrenceId <= 0)
+            continue;
+        QVariantMap occ;
+        occ[QStringLiteral("occurrenceId")] = occurrenceId;
+        occ[QStringLiteral("planId")] =
+            static_cast<qint64>(src.value(QStringLiteral("plan_id")).toDouble());
+        occ[QStringLiteral("title")] = src.value(QStringLiteral("title"));
+        occ[QStringLiteral("dose")] = src.value(QStringLiteral("dose"));
+        occ[QStringLiteral("note")] = src.value(QStringLiteral("note"));
+        occ[QStringLiteral("dueTs")] =
+            static_cast<qint64>(src.value(QStringLiteral("due_ts")).toDouble());
+        occ[QStringLiteral("state")] = src.value(QStringLiteral("state"));
+        occ[QStringLiteral("snoozeCount")] = src.value(QStringLiteral("snooze_count")).toInt();
+        occ[QStringLiteral("snoozeUntilTs")] =
+            static_cast<qint64>(src.value(QStringLiteral("snooze_until_ts")).toDouble());
+        occ[QStringLiteral("windowMin")] = src.value(QStringLiteral("window_min")).toInt();
+        occ[QStringLiteral("escalateAfterMin")] =
+            src.value(QStringLiteral("escalate_after_min")).toInt();
+        incoming.insert(occurrenceId, occ);
+    }
+    if (incoming.isEmpty())
+        return;
+
+    QVariantList merged;
+    QSet<qint64> consumed;
+    for (const QVariant &entry : std::as_const(m_occurrences)) {
+        const QVariantMap existing = entry.toMap();
+        const qint64 id = existing.value(QStringLiteral("occurrenceId")).toLongLong();
+        if (incoming.contains(id)) {
+            merged.append(incoming.value(id));
+            consumed.insert(id);
+        } else {
+            merged.append(existing);
+        }
+    }
+    for (auto it = incoming.constBegin(); it != incoming.constEnd(); ++it) {
+        if (!consumed.contains(it.key()))
+            merged.append(it.value());
+    }
+    m_occurrences = merged;
+    emit occurrencesChanged();
+    emit currentChanged();
+}
+
+// 函数 pendingEvents：还没拿到 server_seq 的事件（SyncEngine 要上传的就是这些）
+QVariantList AppCore::pendingEvents() const
+{
+    QVariantList out;
+    for (const QVariant &entry : m_events) {
+        const QVariantMap event = entry.toMap();
+        if (event.value(QStringLiteral("serverSeq")).toLongLong() <= 0)
+            out.append(event);
+    }
+    return out;
+}
+
+// 函数 markEventsUploaded：把服务端回执的 server_seq 写回本地事件
+void AppCore::markEventsUploaded(const QVariantList &accepted)
+{
+    for (const QVariant &entry : accepted) {
+        const QVariantMap ack = entry.toMap();
+        const QString eventId = ack.value(QStringLiteral("eventId")).toString();
+        const qint64 serverSeq = ack.value(QStringLiteral("serverSeq")).toLongLong();
+        for (int i = 0; i < m_events.size(); ++i) {
+            QVariantMap event = m_events.at(i).toMap();
+            if (event.value(QStringLiteral("eventId")).toString() != eventId)
+                continue;
+            event[QStringLiteral("serverSeq")] = serverSeq;
+            m_events[i] = event;
+            break;
+        }
+    }
+}
